#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" != --install ]]; then
 echo 'Optional download on storage with sufficient free space: lollipop-install-flatpaks --install'
 cat /usr/share/lollipop/flatpak-apps.txt
 exit 0
fi
# Never runs automatically. The previous Live test ran out of overlay storage.
mapfile -t apps < /usr/share/lollipop/flatpak-apps.txt
flatpak --system install flathub "${apps[@]}"
xdg-settings set default-web-browser app.zen_browser.zen.desktop
